{
  "include": [
    "client/src/**/*",
    "shared/**/*",
    "tests/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.db.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "server",
    "data",
    "drizzle",
    "client/src/_core",
    "client/src/lib/trpc.ts",
    "client/src/const.ts",
    "client/src/components/AIChatBox.tsx",
    "client/src/components/ManusDialog.tsx",
    "client/src/components/DashboardLayout.tsx",
    "client/src/components/DashboardLayoutSkeleton.tsx",
    "client/src/pages/ComponentShowcase.tsx",
    "client/src/pages/Home.tsx",
    "shared/const.ts",
    "shared/types.ts",
    "shared/_core"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  }
}
