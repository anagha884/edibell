# EDIBELL configuration template. Copy this file to .env.local in this same folder (proj), then fill it in.
# Fill in the two Supabase values, save, then run `pnpm check:supabase` and restart `pnpm dev`.

# Supabase dashboard → your project → "Connect" (or Project Settings → API Keys)
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_...) or legacy "anon public" key.
# NEVER the secret (sb_secret_...) or service_role key.
VITE_SUPABASE_ANON_KEY=

# Optional: Geoapify key for address search + map (free plan, no card): https://myprojects.geoapify.com
VITE_GEOAPIFY_API_KEY=
